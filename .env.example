# Base de datos
XNX_DB_URL=jdbc:mariadb://localhost:3307/xincronix_bd
XNX_DB_USERNAME=root
XNX_DB_PASSWORD=

# Usa una clave aleatoria de al menos 32 caracteres en producción
XNX_JWT_SECRET=replace-with-at-least-32-random-characters
XNX_JWT_EXPIRATION_MS=86400000
XNX_APP_BASE_URL=http://localhost:8080
# SMTP (use an application password; never commit real credentials)
XNX_MAIL_HOST=smtp.gmail.com
XNX_MAIL_PORT=587
XNX_MAIL_USERNAME=
XNX_MAIL_PASSWORD=
XNX_MAIL_FROM=no-reply@example.com

# Google OAuth
XNX_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
XNX_GOOGLE_CLIENT_SECRET=your-client-secret
XNX_GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google