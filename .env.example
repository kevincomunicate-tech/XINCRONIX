# Copia este archivo como .env para desarrollo local.
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# En producción, con HTTPS, cambia a True (activa cookies seguras y redirección a HTTPS).
DJANGO_HTTPS=False

# SQLite funciona sin instalar ningún servidor de base de datos.
DB_ENGINE=sqlite
SQLITE_FILE=db.sqlite3
# Para MySQL o PostgreSQL, cambia DB_ENGINE y configura la conexion.
# DB_NAME=xincronix_bd
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# Usa 5432 para PostgreSQL, si es el puerto de tu servidor.

# En desarrollo, las invitaciones se imprimen en la terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Xincronix <no-responder@xincronix.local>
# Para que los correos lleguen de verdad (ej. Gmail con contraseña de aplicación), descomenta:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-letras
# DEFAULT_FROM_EMAIL=Xincronix <tu-correo@gmail.com>

# Inicio con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Asistente IA con Gemini (opcional). Clave de Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Modelo de Gemini. Cámbialo aquí si Google retira este o quieres otro.
GEMINI_MODEL=gemini-3.8-flash
# Si el modelo principal está saturado, se intenta con estos, en orden (separados por coma).
GEMINI_MODEL_RESPALDO=gemini-3.6-flash,gemini-3.5-flash-lite
# Preguntas permitidas por persona y por hora.
GEMINI_LIMITE_POR_HORA=60

# GitHub (opcional). Sin token se ven repositorios públicos (60 consultas por hora).
# Token "fine-grained" de solo lectura: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
