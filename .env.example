# Copia este archivo como .env para desarrollo local.
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# En producción, con HTTPS, cambia a True (activa cookies seguras y redirección a HTTPS).
DJANGO_HTTPS=False

# SQLite funciona sin instalar ningún servidor de base de datos.
DB_ENGINE=sqlite
SQLITE_FILE=db.sqlite3

# En desarrollo, las invitaciones se imprimen en la terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Xincronix <no-responder@xincronix.local>

# Inicio con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
