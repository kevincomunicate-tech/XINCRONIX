# ============================================================
# Copia este archivo como .env y cambia los valores.
# El archivo .env NUNCA se sube a GitHub.
# ============================================================

# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=pon-aqui-una-clave-larga-y-secreta
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Muestra en la terminal el SQL que Django envía a la base (True / False)
DJANGO_LOG_SQL=False

# ------------------------------------------------------------
# Motor de base de datos: mysql (por defecto), sqlite o postgresql
# ------------------------------------------------------------
DB_ENGINE=mysql

# --- MySQL / MariaDB (XAMPP) ---
DB_NAME=xincronix_bd
DB_USER=xincronix_user
DB_PASSWORD=escribe-aqui-la-contrasena-del-usuario
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=test_xincronix_bd

# --- SQLite: solo cambia DB_ENGINE=sqlite (lo demás se ignora) ---
# SQLITE_FILE=db.sqlite3

# --- PostgreSQL: DB_ENGINE=postgresql y DB_PORT=5432 ---

# ------------------------------------------------------------
# Inicio de sesión con Google (opcional). Paso a paso en docs/google_login.md
# Sin estos dos valores el botón "Continuar con Google" sale desactivado.
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
